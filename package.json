{
  "name": "incangold.jacobdanderson.net",
  "version": "0.1.12",
  "private": true,
  "engines": {
    "node": "26.13.1",
    "npm": "12.2.2"
  },
  "packageManager": "npm@12.2.2",
  "allowScripts": {
    "esbuild@0.28.2": false,
    "fsevents@2.3.3": false,
    "workerd@1.20261110.1": false,
    "workerd@1.20261113.1": false
  },
  "scripts": {
    "audit:security": "node scripts/build-tools.mjs --audit && node scripts/build-tools.mjs --audit-production && node scripts/build-tools.mjs --audit-signatures && npm audit --audit-level=low && npm audit --omit=dev --audit-level=low && npm audit signatures",
    "dev": "vinext dev",
    "build": "vite build",
    "build:static": "VINEXT_STATIC_BUILD=1 vite build",
    "check": "node scripts/build-tools.mjs --check && npm run format:check && npm run lint && npm run typecheck && npm run verify:native-lock && npm run test:braces && npm run test:dependency-patches && npm run build && npm run build:static && npm run test:static",
    "typecheck": "tsc --noEmit",
    "test:static": "node --test tests/static-build.test.mjs",
    "test:braces": "node --test tests/braces.test.mjs",
    "test:dependency-patches": "node --test tests/dependency-patches.test.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "verify:native-lock": "node scripts/verify-native-lock.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwind-merge": "3.7.0",
    "vinext": "1.4.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/workers-types": "5.20261116.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "braces": "file:vendor/braces",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.162.0"
  },
  "overrides": {
    "braces": "$braces",
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "type": "module"
}
